APP_NAME="Sistem Informasi Manajemen Aset"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aset.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Produksi: gunakan MySQL 8.x atau PostgreSQL. SQLite hanya untuk pengembangan.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_manajemen_aset
DB_USERNAME=aset_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=aset.example.com
CORS_ALLOWED_ORIGINS=https://aset.example.com
FORCE_HTTPS=true
TRUSTED_PROXIES=

# Wajib diisi saat seeding pertama; jangan gunakan kata sandi demo.
SEED_PIMPINAN_NAME="Manajer Organisasi"
SEED_PIMPINAN_EMAIL=pimpinan@example.com
SEED_PIMPINAN_PASSWORD=
SEED_ADMIN_NAME="Admin Aset"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
ORGANIZATION_NAME="Organisasi Anda"
ORGANIZATION_SHORT_NAME=Organisasi
ORGANIZATION_EMAIL=
SEED_DEMO=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
